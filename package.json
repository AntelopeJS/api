{
  "name": "@antelopejs/api",
  "version": "1.5.0",
  "description": "HTTP and WebSocket server module for AntelopeJS, implementing the API interfaces with the Node.js http, https and ws servers",
  "keywords": [
    "antelopejs",
    "api",
    "cors",
    "http",
    "https",
    "server",
    "websocket"
  ],
  "homepage": "https://interfaces.antelopejs.com/docs/api/introduction",
  "bugs": {
    "url": "https://github.com/AntelopeJS/api/issues"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AntelopeJS/api.git"
  },
  "files": [
    "dist"
  ],
  "main": "dist/index.js",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "rimraf dist && tsc",
    "dev": "ajs project run -w -p playground",
    "format": "oxfmt .",
    "lint:fix": "oxlint --fix",
    "lint": "oxlint",
    "prepack": "pnpm run build",
    "release": "pnpm run lint && pnpm run test && release-it",
    "test": "pnpm run build && ajs module test .",
    "format:check": "oxfmt --check .",
    "knip": "knip",
    "prepare": "if git rev-parse --is-inside-work-tree >/dev/null 2>&1 && command -v lefthook >/dev/null 2>&1; then lefthook install; fi",
    "checks": "antelopejs-checks",
    "size": "antelopejs-check-size",
    "ratchet": "antelopejs-ratchet",
    "sync": "antelopejs-sync",
    "ratchet:update": "antelopejs-ratchet --update",
    "sync:check": "antelopejs-sync --check",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@antelopejs/interface-api": ">=0.0.16 <1.0.0",
    "@antelopejs/interface-api-util": ">=0.2.0 <0.3.0",
    "@antelopejs/interface-core": ">=0.2.6 <1.0.0",
    "reflect-metadata": "^0.2.2",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@antelopejs/core": "^1.17.0",
    "@antelopejs/tooling-configs": "^0.2.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.19.15",
    "@types/sinon": "^21.0.0",
    "@types/ws": "^8.18.1",
    "eslint-plugin-perfectionist": "^5.11.0",
    "knip": "^6.34.0",
    "lefthook": "^2.2.2",
    "oxfmt": "^0.66.0",
    "oxlint": "1.81.0",
    "oxlint-tsgolint": "^7.0.2001",
    "release-it": "^19.2.4",
    "release-it-changelogen": "^0.1.0",
    "rimraf": "^6.1.3",
    "sinon": "^21.0.3",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@antelopejs/core": ">=1.17.0 <2"
  },
  "peerDependenciesMeta": {
    "@antelopejs/core": {
      "optional": true
    }
  },
  "packageManager": "pnpm@10.6.5",
  "antelopeJs": {
    "implements": [
      "@antelopejs/interface-api",
      "@antelopejs/interface-api-util"
    ],
    "configVars": [
      "API_PORT",
      "API_LOCAL_BASE_URL",
      "API_PUBLIC_BASE_URL"
    ],
    "configVarsFile": "dist/config-vars.js",
    "test": "src/test/antelope.test.ts",
    "defaultConfig": {
      "servers": [
        {
          "protocol": "http",
          "host": "localhost",
          "port": 8080
        }
      ]
    }
  }
}

{
  "name": "@antelopejs/api",
  "version": "1.2.5",
  "description": "A flexible API module that implements the API interfaces of antelopejs with HTTP and WebSocket support",
  "keywords": [
    "antelopejs",
    "api",
    "http",
    "server",
    "websocket"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AntelopeJS/api.git"
  },
  "files": [
    "dist"
  ],
  "main": "dist/index.js",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "rimraf dist && tsc",
    "dev": "ajs project run -w -p playground",
    "format": "oxfmt .",
    "lint:fix": "oxlint --fix",
    "lint": "oxlint",
    "prepack": "pnpm run build",
    "release": "pnpm run lint && pnpm run test && pnpm run prepack && release-it",
    "test": "pnpm run build && ajs module test .",
    "format:check": "oxfmt --check .",
    "knip": "knip"
  },
  "dependencies": {
    "@antelopejs/interface-api": ">=0.0.12 <1.0.0",
    "@antelopejs/interface-api-util": "^0.1.1",
    "@antelopejs/interface-core": ">=0.0.6 <1.0.0",
    "reflect-metadata": "^0.2.2",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@antelopejs/tooling-configs": "^0.0.4",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.19.15",
    "@types/sinon": "^21.0.0",
    "@types/ws": "^8.18.1",
    "eslint-plugin-perfectionist": "^5.11.0",
    "knip": "^6.34.0",
    "oxfmt": "^0.66.0",
    "oxlint": "1.81.0",
    "oxlint-tsgolint": "^7.0.2001",
    "release-it": "^19.2.4",
    "release-it-changelogen": "^0.1.0",
    "rimraf": "^6.1.3",
    "sinon": "^21.0.3",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@10.6.5",
  "antelopeJs": {
    "implements": [
      "@antelopejs/interface-api",
      "@antelopejs/interface-api-util"
    ],
    "test": "src/test/antelope.test.ts",
    "defaultConfig": {
      "servers": [
        {
          "protocol": "http",
          "host": "localhost",
          "port": 8080
        }
      ]
    }
  }
}
